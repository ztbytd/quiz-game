{
  "name": "interview-workbench",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.cjs",
    "test:practice": "node scripts/verify-practice.cjs",
    "test:e2e": "node scripts/verify-e2e.mjs",
    "content:validate": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "idb": "8.0.4",
    "pinia": "^3.0.4",
    "vue": "3.5.46",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "fake-indexeddb": "^6.0.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
